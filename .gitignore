results/config.json
results/environment_and_audit.json
results/R_sessionInfo.txt
report/R_report_sessionInfo.txt
report/.raw_before_style.docx
checksums.sha256

# Temporary files and credentials
tmp/
.venv/
.env
.Renviron
.Rhistory
.RData
*.key
*.pem
~$*
